[
  {
    "name": "Assertion / Validation",
    "matchedStatuses": ["failed"],
    "messageRegex": ".*Assertion.*|.*expected.*but was.*"
  },
  {
    "name": "Configuration",
    "matchedStatuses": ["broken"],
